FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}

fluxScheme      Kurganov;

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default             none;
    div(phi,k)          Gauss limitedLinear 1;
    div(phi,epsilon)    Gauss limitedLinear 1;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default              linear;
    reconstruct(rho)     vanAlbada;
    reconstruct(U)       vanAlbadaV;
    reconstruct(T)       vanAlbada;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;
}
